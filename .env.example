# Convex Configuration (auto-configured by npx convex dev)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# E2B Sandbox API Key (optional - demo mode works without)
# Get your key at: https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here

# OpenAI API Key (optional - demo mode uses simulated responses)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: Convex Auth (for production)
# CONVEX_AUTH_DOMAIN=your-convex-deployment.convex.cloud
# CONVEX_AUTH_CLIENT_ID=your_client_id
